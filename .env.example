# Add these environment variables in Vercel Dashboard
# Settings > Environment Variables

NEXT_PUBLIC_IAM_URL=https://your-iam-service-url.com

# Commerce API (shop, galleries)
NEXT_PUBLIC_ECOM_API_URL=https://your-commerce-api-url.com
NEXT_PUBLIC_STORE_SLUG=gracejeanne

# Contact form (app/contact) — same setup as onehealthclinics
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=inbox-that-receives-messages@example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
